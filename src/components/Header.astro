---
import { type Lang } from '@/i18n/ui';
import { useTranslations, getOtherLang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang = getOtherLang(lang);
const otherLangPath = `/${otherLang}/`;
const otherLangLabel = otherLang.toUpperCase();
---

<header
  class="sticky top-0 z-40 w-full border-b border-border bg-bg/90 backdrop-blur-md transition-colors duration-200"
>
  <div
    class="max-w-container mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between"
  >
    <a
      href={`/${lang}/`}
      class="font-semibold text-text tracking-tight hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 rounded"
    >
      Moch. Dicky
    </a>

    <nav
      aria-label="Navigasi Utama"
      class="flex items-center gap-4 sm:gap-6 text-sm"
    >
      <ul class="flex items-center gap-3 sm:gap-5 text-muted font-medium">
        <li>
          <a
            href="#proyek"
            class="hover:text-text transition-colors py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
          >
            {t('nav.projects')}
          </a>
        </li>
        <li>
          <a
            href="#tentang"
            class="hover:text-text transition-colors py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
          >
            {t('nav.about')}
          </a>
        </li>
        <li>
          <a
            href="#kontak"
            class="hover:text-text transition-colors py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
          >
            {t('nav.contact')}
          </a>
        </li>
      </ul>

      <div class="flex items-center gap-2 border-l border-border pl-3 sm:pl-4">
        <!-- Pengalih Bahasa -->
        <a
          href={otherLangPath}
          aria-label={t('nav.lang_toggle')}
          class="px-2 py-1 text-xs font-mono font-medium rounded-btn border border-border text-muted hover:text-text hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          {otherLangLabel}
        </a>

        <!-- Pengalih Mode Terang/Gelap -->
        <button
          id="theme-toggle-btn"
          type="button"
          aria-label={t('nav.theme_toggle')}
          class="p-2 rounded-btn border border-border text-muted hover:text-text hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <!-- Ikon Matahari (tampil saat mode gelap) -->
          <svg
            class="w-4 h-4 hidden dark:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <!-- Ikon Bulan (tampil saat mode terang) -->
          <svg
            class="w-4 h-4 block dark:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>
