---
import { type Lang } from '@/i18n/ui';
import { useTranslations, getOtherLang } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang = getOtherLang(lang);
const otherLangPath = `/${otherLang}/`;
const otherLangLabel = otherLang.toUpperCase();

const navLinks = [
  { href: '#proyek', label: t('nav.projects') },
  { href: '#tentang', label: t('nav.about') },
  { href: '#kontak', label: t('nav.contact') },
];
---

<header
  class="sticky top-0 z-40 w-full border-b border-border bg-bg/90 backdrop-blur-md transition-colors duration-200"
>
  <div
    class="max-w-container mx-auto px-4 sm:px-6 h-14 sm:h-16 flex items-center justify-between"
  >
    <!-- Logo / Nama -->
    <a
      href={`/${lang}/`}
      class="font-semibold text-text tracking-tight hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 rounded"
    >
      Moch. Dicky
    </a>

    <!-- Desktop Nav -->
    <nav
      aria-label="Navigasi Utama"
      class="hidden sm:flex items-center gap-4 sm:gap-6 text-sm"
    >
      <ul class="flex items-center gap-3 sm:gap-5 text-muted font-medium">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-text transition-colors py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2 border-l border-border pl-3 sm:pl-4">
        <!-- Pengalih Bahasa -->
        <a
          href={otherLangPath}
          aria-label={t('nav.lang_toggle')}
          class="px-2 py-1 text-xs font-mono font-medium rounded-btn border border-border text-muted hover:text-text hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          {otherLangLabel}
        </a>

        <!-- Pengalih Tema -->
        <button
          id="theme-toggle-btn"
          type="button"
          aria-label={t('nav.theme_toggle')}
          class="p-2 rounded-btn border border-border text-muted hover:text-text hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <!-- Ikon Matahari (tampil di mode gelap) -->
          <svg
            class="w-4 h-4 hidden dark:block"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
          <!-- Ikon Bulan (tampil di mode terang) -->
          <svg
            class="w-4 h-4 block dark:hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile: Kontrol kanan (Tema + Bahasa + Hamburger) -->
    <div class="flex sm:hidden items-center gap-2">
      <!-- Pengalih Bahasa mobile -->
      <a
        href={otherLangPath}
        aria-label={t('nav.lang_toggle')}
        class="px-2 py-1 text-xs font-mono font-medium rounded-btn border border-border text-muted hover:text-text hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        {otherLangLabel}
      </a>

      <!-- Pengalih Tema mobile -->
      <button
        id="theme-toggle-btn-mobile"
        type="button"
        aria-label={t('nav.theme_toggle')}
        class="p-2 rounded-btn border border-border text-muted hover:text-text hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg
          class="w-4 h-4 hidden dark:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          class="w-4 h-4 block dark:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Hamburger button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label={t('nav.menu_open')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="p-2 rounded-btn border border-border text-muted hover:text-text hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <!-- Ikon hamburger (tampil saat menu tertutup) -->
        <svg
          id="icon-hamburger"
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <!-- Ikon close (tampil saat menu terbuka) -->
        <svg
          id="icon-close"
          class="w-4 h-4 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden sm:hidden border-t border-border bg-bg/95 backdrop-blur-md"
    role="navigation"
    aria-label="Menu Navigasi Mobile"
  >
    <ul class="max-w-container mx-auto px-4 py-3 flex flex-col gap-1">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-nav-link block py-2.5 px-3 rounded-btn text-sm font-medium text-muted hover:text-text hover:bg-surface transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconH = document.getElementById('icon-hamburger');
    const iconC = document.getElementById('icon-close');
    if (!btn || !menu) return;

    function toggleMenu(open) {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      iconH?.classList.toggle('hidden', open);
      iconC?.classList.toggle('hidden', !open);
    }

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      toggleMenu(!isOpen);
    });

    // Tutup menu saat link di-klik
    menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    // Tutup saat resize ke desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 640) toggleMenu(false);
    });

    // Mobile theme toggle — sync dengan tombol desktop
    const mobileThemeBtn = document.getElementById('theme-toggle-btn-mobile');
    if (mobileThemeBtn && !mobileThemeBtn.dataset.themeBound) {
      mobileThemeBtn.dataset.themeBound = 'true';
      mobileThemeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {
          /* ignore */
        }
      });
    }
  })();
</script>
