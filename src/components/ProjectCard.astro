---
import { type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  project: {
    title: string;
    problem: string;
    role: string;
    techStack: string[];
    impact: string;
    demoUrl?: string;
    repoUrl?: string;
    image: string;
    imageAlt: string;
  };
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);
---

<article
  class="bg-surface border border-border rounded-card p-5 sm:p-6 flex flex-col justify-between transition-colors duration-200 hover:border-accent"
>
  <div class="space-y-4">
    <!-- Screenshot Tunggal (16:9) -->
    <div
      class="aspect-video w-full overflow-hidden rounded-lg border border-border bg-bg/50"
    >
      <img
        src={project.image}
        alt={project.imageAlt}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Judul & Peran -->
    <div class="space-y-1">
      <div
        class="flex items-center justify-between text-xs font-mono text-muted"
      >
        <span>{project.role}</span>
      </div>
      <h3 class="text-lg sm:text-xl font-semibold text-text tracking-tight">
        {project.title}
      </h3>
    </div>

    <!-- Masalah yang Diselesaikan -->
    <p class="text-sm text-muted leading-relaxed">
      {project.problem}
    </p>

    <!-- Hasil / Dampak -->
    <div class="p-3 rounded-lg bg-bg/60 border border-border/80">
      <p class="text-xs font-medium text-text leading-snug">
        <span class="text-accent font-semibold">Impact:</span>
        {project.impact}
      </p>
    </div>

    <!-- Label Tech Stack -->
    <div class="flex flex-wrap gap-1.5 pt-1" aria-label="Tech Stack">
      {
        project.techStack.map((tech) => (
          <span class="inline-flex items-center font-mono text-xs px-2.5 py-1 rounded-full bg-border/40 text-text border border-border/50">
            {tech}
          </span>
        ))
      }
    </div>
  </div>

  <!-- Tautan Demo & Repo -->
  <div class="flex items-center gap-3 pt-5 mt-4 border-t border-border">
    {
      project.demoUrl && (
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-1.5 text-xs sm:text-sm font-medium rounded-btn bg-accent text-white hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-opacity"
        >
          <span>{t('projects.demo')}</span>
          <svg
            class="w-3.5 h-3.5 ml-1.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      )
    }

    {
      project.repoUrl && (
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-1.5 text-xs sm:text-sm font-medium rounded-btn border border-border text-text hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors"
        >
          <span>{t('projects.repo')}</span>
          <svg
            class="w-3.5 h-3.5 ml-1.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>
