---
import { type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  project: {
    title: string;
    problem: string;
    role: string;
    techStack: string[];
    impact: string;
    demoUrl?: string;
    repoUrl?: string;
    image: string;
    imageAlt: string;
  };
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);

// Deteksi apakah file gambar adalah placeholder (< 100 byte → file minimal)
const isPlaceholderImage =
  project.image.endsWith('.webp') &&
  project.image.startsWith('/projects/project-');
---

<article
  class="bg-surface border border-border rounded-card p-5 sm:p-6 flex flex-col justify-between transition-colors duration-200 hover:border-accent group"
>
  <div class="space-y-4">
    <!-- Screenshot Tunggal (16:9) -->
    <div
      class="aspect-video w-full overflow-hidden rounded-lg border border-border bg-bg/50"
    >
      {
        isPlaceholderImage ? (
          <div class="w-full h-full flex flex-col items-center justify-center gap-3 text-border group-hover:text-muted transition-colors">
            <svg
              class="w-10 h-10"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <p class="text-xs font-mono text-center px-4">
              {t('projects.image_placeholder')}
            </p>
          </div>
        ) : (
          <img
            src={project.image}
            alt={project.imageAlt}
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        )
      }
    </div>

    <!-- Peran & Judul -->
    <div class="space-y-1">
      <p class="text-xs font-mono text-muted">{project.role}</p>
      <h3 class="text-lg sm:text-xl font-semibold text-text tracking-tight">
        {project.title}
      </h3>
    </div>

    <!-- Masalah yang Diselesaikan -->
    <p class="text-sm text-muted leading-relaxed">
      {project.problem}
    </p>

    <!-- Hasil / Dampak -->
    <div class="p-3 rounded-lg bg-bg/60 border border-border/80">
      <p class="text-xs font-medium text-text leading-snug">
        <span class="text-accent font-semibold"
          >{t('projects.impact_label')}:</span
        >
        {project.impact}
      </p>
    </div>

    <!-- Label Tech Stack -->
    <div class="flex flex-wrap gap-1.5 pt-1" aria-label="Tech Stack">
      {
        project.techStack.map((tech) => (
          <span class="inline-flex items-center font-mono text-xs px-2.5 py-1 rounded-full bg-border/40 text-text border border-border/50">
            {tech}
          </span>
        ))
      }
    </div>
  </div>

  <!-- Tautan Demo & Repo -->
  <div class="flex items-center gap-3 pt-5 mt-4 border-t border-border">
    {
      project.demoUrl && (
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-1.5 text-xs sm:text-sm font-medium rounded-btn bg-accent text-white hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-opacity"
        >
          <span>{t('projects.demo')}</span>
          <svg
            class="w-3.5 h-3.5 ml-1.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      )
    }

    {
      project.repoUrl && (
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] px-3.5 py-1.5 text-xs sm:text-sm font-medium rounded-btn border border-border text-text hover:border-accent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors"
        >
          <svg
            class="w-3.5 h-3.5 mr-1.5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
          <span>{t('projects.repo')}</span>
        </a>
      )
    }
  </div>
</article>
