---
import { getCollection } from 'astro:content';
import { type Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Ambil data proyek berdasarkan bahasa dari content collection
const allProjects = await getCollection('projects', ({ id }) =>
  id.startsWith(`${lang}/`)
);
const sortedProjects = allProjects
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 4); // Maksimal 4 proyek sesuai aturan AGENTS.md
---

<section id="proyek" class="py-16 sm:py-24 border-b border-border scroll-mt-16">
  <div class="space-y-8">
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-text">
        {t('projects.title')}
      </h2>
      <p class="text-muted text-sm sm:text-base max-w-prose">
        {t('projects.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        sortedProjects.map((project) => (
          <ProjectCard lang={lang} project={project.data} />
        ))
      }
    </div>
  </div>
</section>
